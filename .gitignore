# ── Secrets ────────────────────────────────────────────────────────────────
# Never commit real environment files. The *.example templates ARE committed:
# they document which variables exist without carrying any values.
.env
.env.*
*.env
!.env.example
!.env.sample

*.pem
*.key
.credentials
credentials.json
*credentials.json*
*token.json*

# ── Dependencies ───────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── Build output ───────────────────────────────────────────────────────────
frontend/build/
build/
dist/
.cache/
*.tsbuildinfo

# ── Vercel ─────────────────────────────────────────────────────────────────
.vercel

# ── Test / coverage ────────────────────────────────────────────────────────
coverage/
.pytest_cache/
.coverage
htmlcov/

# ── Logs ───────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ── Editors and OS ─────────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# ── Large binaries that should not live in git ─────────────────────────────
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
*.pack
