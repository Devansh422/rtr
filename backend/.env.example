# Backend configuration. Copy to backend/.env for local development.
# On Vercel these are set as Environment Variables in the project dashboard
# (Settings -> Environment Variables), NOT in this file.
#
# MONGO_URL, DB_NAME, JWT_SECRET, ADMIN_EMAIL and ADMIN_PASSWORD are required:
# the app reads them at import time and will fail to start if any is missing.

# MongoDB connection string. Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Mongo holds CMS content (blogs, news, FAQ, campaigns) and public form
# submissions.
MONGO_URL=mongodb://localhost:27017

# Name of the database to use inside that cluster.
DB_NAME=rtr_movement

# Secret used to sign admin JWTs - use a long random string (openssl rand -hex 32).
# Also salts the audit log's IP hashes, so changing it makes previously stored
# hashes uncomparable (harmless, but worth knowing).
JWT_SECRET=change-me-to-a-long-random-string

# Admin account seeded on startup; this is the login for /admin/login.
# It is created as a Super Admin and cannot be deleted or deactivated from the
# UI - change this variable and redeploy instead.
ADMIN_EMAIL=admin@example.com

# Admin password. Changing it and redeploying resets the stored password.
ADMIN_PASSWORD=change-me

# Optional: comma-separated list of allowed CORS origins. Defaults to "*".
# Not needed for the single-origin Vercel deploy; set it when the API is called
# from a different domain, e.g. CORS_ORIGINS=https://example.com,https://www.example.com
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Postgres (Neon) - required for everything added in Phase 0 and after
# ---------------------------------------------------------------------------
# Holds staff identity, roles and permissions, geographic scoping, the states
# table and the append-only audit log. Everything relational added later
# (representatives, promises, petitions, forum, citizen reports) goes here too.
#
# Leaving it UNSET is supported but degraded: the app falls back to the
# pre-Phase-0 Mongo-only auth path, and every endpoint that needs the relational
# database answers 503. GET /api/health reports which mode an instance is in.
#
# Free tier: https://neon.com - create a project, copy the connection string.
# A plain postgresql:// URL is fine; the driver prefix is added automatically.
# Note Neon autosuspends after 5 minutes idle on the free tier, so the first
# request after a quiet period pays a cold start.
#
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/rtr?sslmode=require

# Development/test only. Creates tables directly from the models instead of
# running Alembic. NEVER set this in a deployed environment - it diverges the
# live schema from the migration history.
# AUTO_CREATE_TABLES=1
