# Backend configuration. Copy to backend/.env for local development.
# On Vercel these are set as Environment Variables in the project dashboard
# (Settings -> Environment Variables), NOT in this file.
#
# MONGO_URL, DB_NAME, JWT_SECRET, ADMIN_EMAIL and ADMIN_PASSWORD are required:
# the app reads them at import time and will fail to start if any is missing.

# MongoDB connection string. Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017

# Name of the database to use inside that cluster.
DB_NAME=rtr_movement

# Secret used to sign admin JWTs - use a long random string (openssl rand -hex 32).
JWT_SECRET=change-me-to-a-long-random-string

# Admin account seeded on startup; this is the login for /admin/login.
ADMIN_EMAIL=admin@example.com

# Admin password. Changing it and redeploying resets the stored password.
ADMIN_PASSWORD=change-me

# Optional: comma-separated list of allowed CORS origins. Defaults to "*".
# Not needed for the single-origin Vercel deploy; set it when the API is called
# from a different domain, e.g. CORS_ORIGINS=https://example.com,https://www.example.com
CORS_ORIGINS=*
