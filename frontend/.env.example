# Frontend build-time configuration (Create React App / craco).
# Copy to frontend/.env only if you actually need to override the default.

# Base URL of the API. LEAVE THIS EMPTY / UNSET for the Vercel deployment:
# the frontend and the FastAPI function are served from the same origin, so the
# code falls back to the relative path /api, which is what you want.
#
# Set it ONLY when the backend runs somewhere other than the page itself, e.g.
# a local backend while running `npm start`, or a separately hosted API:
#   REACT_APP_BACKEND_URL=http://localhost:8000
# The value must NOT include the trailing /api - the client appends it.
REACT_APP_BACKEND_URL=
